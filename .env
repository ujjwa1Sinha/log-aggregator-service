# MongoDB (Local Docker Container)
MONGO_URI=mongodb://admin:admin123@mongodb:27017/log-aggregator?authSource=admin
# Redis (Local Docker Container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_SSL=false

# Kafka (local docker service - usually unchanged)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=log-data

# Elasticsearch (local docker service)
ELASTICSEARCH_URIS=http://elasticsearch:9200
